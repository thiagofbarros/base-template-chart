{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "base-template-chart values",
  "type": "object",
  "properties": {
    "nameOverride": { "type": "string" },
    "application": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "environment": { "type": "string" },
        "type": { "type": "string", "enum": ["deployment"] }
      },
      "required": ["name", "type"]
    },
    "deployment": {
      "type": "object",
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "hpa": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": ["integer", "null"] },
            "targetMemoryUtilizationPercentage": { "type": ["integer", "null"] }
          },
          "required": ["enabled"]
        },
        "strategy": { "type": "object" }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "imagePullSecrets": { "type": "array" },
    "env": { "type": "array" },
    "envFromConfigMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "envFromSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "externalSecrets": { "type": ["object", "null"] },
    "configMaps": {
      "type": ["object", "null"],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "mountAs": { "type": "string", "enum": ["env", "file"] },
          "envFrom": { "type": "boolean" },
          "mountPath": { "type": "string", "minLength": 1 },
          "subPath": { "type": "string" },
          "readOnly": { "type": "boolean" },
          "defaultMode": { "type": "integer", "minimum": 0, "maximum": 511 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "path": { "type": "string" },
                "mode": { "type": "integer", "minimum": 0, "maximum": 511 }
              },
              "required": ["key", "path"]
            }
          },
          "data": { "type": ["object", "null"] },
          "binaryData": { "type": ["object", "null"] },
          "labels": { "type": ["object", "null"] },
          "annotations": { "type": ["object", "null"] },
          "immutable": { "type": "boolean" }
        },
        "if": {
          "properties": { "mountAs": { "const": "file" } },
          "required": ["mountAs"]
        },
        "then": { "required": ["mountPath"] }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]
        },
        "size": { "type": "string" },
        "mountPath": { "type": "string" },
        "storageClass": { "type": "string" }
      },
      "required": ["enabled"]
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "emptyDir": {
            "type": ["object", "null"],
            "properties": {
              "medium": { "type": "string", "enum": ["", "Memory"] },
              "sizeLimit": { "type": ["string", "integer"] }
            },
            "additionalProperties": false
          }
        },
        "required": ["name"]
      }
    },
    "volumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "mountPath": { "type": "string" },
          "subPath": { "type": "string" },
          "readOnly": { "type": "boolean" }
        },
        "required": ["name", "mountPath"]
      }
    },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]
        },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      },
      "required": ["type", "port"]
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": { "type": "array" },
        "tls": { "type": "array" }
      },
      "required": ["enabled"]
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array" },
        "rules": { "type": "array" }
      },
      "required": ["enabled"]
    }
  },
  "required": ["application", "image", "service"]
}
