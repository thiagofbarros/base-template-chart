# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/
# CI / repo tooling — not part of the chart artifact
.github/
.claude/
ct.yaml
.helmignore
# Test/CI value fixtures — not part of the chart artifact
ci/
test/
# Docs
README.md
*.md
